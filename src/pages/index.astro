---
import Layout from '../layouts/Layout.astro';
import Portrait from '../components/Portrait.astro';
import { identity, techFeatured, essays, debateResults } from '../data/site';
---

<Layout title={identity.name} description={identity.statement} hero3d>
  <section class="hero hero--me" aria-label="Introduction">
    <div class="hero__canvas">
      <canvas data-hero-field aria-hidden="true"></canvas>
    </div>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="shell hero__inner">
      <div>
        <p class="kicker" data-reveal>{identity.role}</p>
        <h1 class="display" data-reveal>
          Justice <span class="gold">Thinker</span>
        </h1>
        <p class="lede" data-reveal>
          {identity.statement} Software pays the bills, physics feeds the curiosity, and
          debate is where ideas get tested.
        </p>
        <div class="actions" data-reveal>
          <a class="btn btn--gold" href="/tech">See the work</a>
          <a class="btn btn--ghost" href={identity.substack} target="_blank" rel="noopener noreferrer">
            Read the essays
          </a>
        </div>
        <p class="hero__hint" data-reveal>Hover or drag · the field answers, then settles</p>
      </div>

      <Portrait />
    </div>
  </section>

  <div class="shell">
    <section class="section" aria-label="The three registers">
      <div class="section__head" data-reveal>
        <h2 class="title">One person, three registers</h2>
        <p class="note">Each page below is the real record, not a brochure.</p>
      </div>

      <div class="cards cards--three" data-reveal-group>
        <article class="card" data-tilt data-reveal>
          <span class="gate__index">01</span>
          <h3 class="card__name">Tech</h3>
          <p class="card__body">
            {techFeatured.length} featured builds and {17} more public repos — offline-first
            apps, trading front ends, agents, bots. Everything linked to the code.
          </p>
          <a class="card__link" href="/tech">Browse the repos →</a>
        </article>

        <article class="card" data-tilt data-reveal>
          <span class="gate__index">02</span>
          <h3 class="card__name">Debate &amp; speaking</h3>
          <p class="card__body">
            {debateResults[0].placing} at the {debateResults[0].event}, a season title, an
            international final — plus the talks and the four rules behind them.
          </p>
          <a class="card__link" href="/debate">See the record →</a>
        </article>

        <article class="card" data-tilt data-reveal>
          <span class="gate__index">03</span>
          <h3 class="card__name">Writing</h3>
          <p class="card__body">
            “{essays[0].title}” and the rest of the essays, published on Substack as
            “{identity.tagline}”
          </p>
          <a class="card__link" href="/writing">Read the essays →</a>
        </article>
      </div>
    </section>

    <section class="section" aria-label="Contact">
      <div class="section__head" data-reveal>
        <h2 class="title">Write to me</h2>
        <p class="note">A problem first, an introduction second. That order works best.</p>
      </div>
      <div class="actions" data-reveal>
        <a class="btn btn--gold" href={`mailto:${identity.email}`}>{identity.email}</a>
        <a class="btn btn--ghost" href={identity.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="btn btn--ghost" href={identity.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </section>
  </div>

  <script>
    import '../scripts/hero.js';
  </script>
</Layout>
