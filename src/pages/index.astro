---
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';
import { identity, projects, posts } from '../data/site';

const featured = projects.filter((project) => project.featured).slice(0, 4);
const latest = posts.slice(0, 3);
---

<Layout title={identity.name}>
  <div class="shell">
    <section class="opener">
      <p class="opener__kicker">{identity.role}</p>
      <h1 class="display">I study how things separate when they are measured.</h1>
      <p class="lede">
        Quantum systems, arguments, and software. Three disciplines, one method — build the
        instrument, then trust what it says.
      </p>
    </section>
  </div>

  <div class="shell">
    <Figure
      src="/art/ink.webp"
      width={1600}
      height={1000}
      bleed
      priority
      alt="Fine black contour lines on warm paper, forming a dense interference pattern that opens out and fades toward the edges of the sheet."
      caption="Three emitters summed into one field and drawn as line work: ink where the sum crosses a fixed value. Generated from the wave equation — nothing on this site was photographed or bought."
    />
  </div>

  <div class="shell">
    <section class="section">
      <div class="section__head">
        <h2 class="title">Selected work</h2>
        <p class="note">
          Four of ten. The rest, with the detail behind each, are on the
          <a class="link" href="/projects">work page</a>.
        </p>
      </div>

      <div class="work">
        {
          featured.map((project) => (
            <article class="work__item">
              <div class="work__row">
                <h3 class="work__name">{project.name}</h3>
                <span class="work__meta">
                  {project.year} · {project.status}
                </span>
              </div>
              <p class="work__line">{project.summary}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Writing</h2>
        <p class="note">Physics, software, and the space where they argue.</p>
      </div>

      <div class="posts">
        {
          latest.map((post) => (
            <article class="post">
              <time class="post__date" datetime={post.iso}>
                {post.date} · {post.reading}
              </time>
              <h3 class="post__title">{post.title}</h3>
              <p class="post__dek">{post.dek}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">About</h2>
      </div>

      <div class="prose">
        <p>
          I read physics at university, spent four years on the quantum-to-classical boundary, and
          have been writing software for longer than that. Between the two I argue — competitively,
          in finals, and on behalf of students I coach.
        </p>
        <p>
          The through-line is measurement: a model of a system that cannot be seen, a service that
          has to survive contact with real users, an argument tested against someone trying to break
          it. The method transfers, which is the only interesting part.
        </p>
        <p>
          <a class="link link--accent" href="/about">More about me</a> — or
          <a class="link" href={`mailto:${identity.email}`}>write to me</a>.
        </p>
      </div>
    </section>
  </div>
</Layout>
