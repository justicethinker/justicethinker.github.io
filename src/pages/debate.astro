---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import { debateResults, debateRules } from '../data/site';
---
<Layout
  title="Debate — Ikechukwu Emmanuel Isaac (Justice Thinker), Debater, Judge & Coach, Nigeria"
  description="The debating record of Ikechukwu Emmanuel Isaac (Justice Thinker), a Full-Stack & AI Engineer in Nigeria: Débatteur d'Or nominee, university debate judge and coach."
>
  <header class="page-head">
    <div class="wrap">
      <p class="label label--ember">Debate</p>
      <h1>I argue for sport, and judge and coach others.</h1>
      <p>I compete, adjudicate and coach in Nigerian and West African university debating. It's where I learned to say a thing once and make it hold.</p>
    </div>
  </header>

  <section class="section" aria-labelledby="rules-title">
    <div class="wrap">
      <div class="section__head">
        <p class="label label--ember">How I argue</p>
        <h2 id="rules-title">Four rules.</h2>
        <p>The standard I hold an argument to, whether I am making it or judging it.</p>
      </div>
      <ol class="rules">
        {debateRules.map((r, i) => (
          <li>
            <span class="label label--ember">Rule {String(i + 1).padStart(2, '0')}</span>
            <h3>{r.name}</h3>
            <p>{r.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="record-title">
    <div class="wrap">
      <div class="section__head">
        <p class="label label--ember">Record</p>
        <h2 id="record-title">Where I've debated, judged and organised.</h2>
      </div>
      <ul class="record">
        {debateResults.map((r) => (
          <li>
            <span class="label">{r.when}</span>
            <div><h3>{r.event}</h3><p>{r.body}</p></div>
            <span class="placing">{r.placing}</span>
          </li>
        ))}
        <li>
          <span class="label">Ongoing</span>
          <div><h3>Coaching</h3><p>About 50 students coached.</p></div>
          <span class="placing">Coach</span>
        </li>
      </ul>
    </div>
  </section>

  <Contact />
</Layout>
