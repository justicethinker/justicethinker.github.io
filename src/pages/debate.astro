---
import Layout from '../layouts/Layout.astro';
import { debateResults, talks, debateRules } from '../data/site';
---

<Layout
  title="Debate"
  description="Debate results, talks, and rules."
>
  <div class="stage" data-scale-stage>
    <canvas class="stage__canvas" data-scale-canvas aria-hidden="true"></canvas>
    <div class="stage__scrim stage__scrim--scales" aria-hidden="true"></div>

    <script
      type="application/json"
      data-scale-data
      set:html={JSON.stringify(debateResults.map((r) => ({ placing: r.placing, event: r.event })))}
    />
  </div>

  <div class="page">
    <div class="shell">
      <section class="opener plate" aria-label="Introduction">
        <p class="kicker">Debate &amp; public speaking</p>
        <h1 class="display display--md">
          Debate <span class="gold">results.</span>
        </h1>
        <p class="lede" data-selectable>
          Drag a result onto a side of the scale, or focus one and press ← or →.
          The heavier side goes down.
        </p>
      </section>

      <section class="section" data-balance-next aria-label="Results">
        <div class="section__head plate">
          <h2 class="title">Results</h2>
          <p class="note">Results from competitions.</p>
        </div>

        <p class="sr-only" id="weigh-hint">
          Press the left arrow key to put this result on the left side of the scale,
          or the right arrow key to put it on the right side.
        </p>

        <div class="cards" data-reveal-group>
          {
            debateResults.map((result, i) => (
              <article
                class="card card--weigh"
                role="button"
                tabindex="0"
                aria-describedby="weigh-hint"
                aria-label={`${result.event} — drag onto a side, or press the left or right arrow to place it`}
                data-weigh-index={i}
                data-reveal
              >
                <span class="card__meta">
                  {result.when} · {result.placing} · {result.format}
                </span>
                <h3 class="card__name">{result.event}</h3>
                <p class="card__body">{result.body}</p>
                <span class="card__weigh">Drag onto a side · ← left · → right</span>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" aria-label="Talks">
        <div class="section__head">
          <h2 class="title">Talks</h2>
          <p class="note">Talks I've given.</p>
        </div>

        <div class="cards" data-reveal-group>
          {
            talks.map((talk) => (
              <article class="card" data-tilt data-reveal>
                <span class="card__meta">
                  {talk.venue} · {talk.meta}
                </span>
                <h3 class="card__name">{talk.title}</h3>
                <p class="card__body">{talk.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" aria-label="The four rules">
        <div class="section__head">
          <h2 class="title">Four rules</h2>
          <p class="note">I use these for papers and code reviews too.</p>
        </div>

        <div class="cards cards--two" data-reveal-group>
          {
            debateRules.map((rule, i) => (
              <article class="card" data-tilt data-reveal>
                <span class="gate__index">0{i + 1}</span>
                <h3 class="card__name">{rule.name}</h3>
                <p class="card__body">{rule.body}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <aside class="hud hud--aside" aria-label="Balance controls">
    <button class="to-top" type="button" data-scale-add-for>Weigh a win for</button>
    <button class="to-top" type="button" data-scale-add-against>Weigh a win against</button>
    <button class="to-top" type="button" data-scale-reset>Reset</button>
    <p class="hud__hint" data-scale-readout role="status"></p>
  </aside>

  <script>
    import '../scripts/scales.js';
  </script>
</Layout>
