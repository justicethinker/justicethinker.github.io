---
import Layout from '../layouts/Layout.astro';
import { identity, techFeatured, techMore } from '../data/site';

const tints = ['#f0d878', '#d4af37', '#e8c96a', '#c9a227', '#f6e58d', '#b08d2a'];
---

<Layout
  title="Tech"
  description="Projects by Justice Thinker, with links to the code on GitHub."
>
  <div class="stage" data-orbit-stage>
    <canvas class="stage__canvas" data-orbit-canvas aria-hidden="true"></canvas>
    <div class="stage__scrim stage__scrim--orbit" aria-hidden="true"></div>

    <script type="application/json" data-orbit-data set:html={JSON.stringify(techFeatured)} />
  </div>

  {/*
    The scene's controls live outside the stage wrapper, in the same layer as
    the content, so a line of copy can never paint over a button.
  */}
  <aside class="orbit__panel" data-orbit-panel data-orbit-avoid hidden aria-live="polite">
    <p class="card__meta" data-orbit-meta></p>
    <h2 class="card__name" data-orbit-name></h2>
    <p class="card__body" data-orbit-body></p>
    <div class="actions">
      <a
        class="card__link"
        data-orbit-link
        href={identity.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        Open on GitHub →
      </a>
      <button class="to-top" type="button" data-orbit-close>Close</button>
    </div>
  </aside>

  <div class="orbit__bar" data-orbit-avoid>
    <button class="to-top" type="button" data-orbit-prev>← Prev</button>
    <button class="to-top" type="button" data-orbit-next>Next →</button>
    <button class="to-top" type="button" data-orbit-zoom-in aria-label="Zoom in">+</button>
    <button class="to-top" type="button" data-orbit-zoom-out aria-label="Zoom out">−</button>
    <span class="orbit__hint">Scroll to zoom · drag to spin · click a project to read about it</span>
  </div>

  <div class="page">
    <div class="shell">
      <section class="opener plate" aria-label="Introduction" data-orbit-intro>
        <p class="kicker">Tech</p>
        <h1 class="display display--md">
          Projects.
        </h1>
        <p class="lede" data-selectable>
          {identity.githubHandle} — {techFeatured.length} featured projects. Click one
          to read what it is, with a link to the code.
        </p>
        <div class="actions">
          <a class="btn btn--gold" href={identity.github} target="_blank" rel="noopener noreferrer">
            Open the GitHub profile
          </a>
        </div>
      </section>

      <section class="section" aria-label="More repos" id="record">
        <div class="section__head plate" data-orbit-avoid>
          <h2 class="title">More repos</h2>
          <p class="note">Learning work, experiments and tools.</p>
        </div>

        <ul class="index" data-reveal-group>
          {
            techMore.map((repo) => (
              <li data-reveal>
                <a class="index__row" href={repo.url} target="_blank" rel="noopener noreferrer">
                  <span class="index__name">{repo.name}</span>
                  <span class="index__detail">
                    {repo.language} — {repo.body}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <aside class="hud hud--corner hud--repos" aria-label="Repositories">
    <div class="repo-hud__head">
      <span class="micro">Featured</span>
      <a class="repo-hud__jump link" href="#record">See all {techMore.length} more ↓</a>
    </div>

    <ul class="repo-hud__list">
      {
        techFeatured.map((repo, i) => (
          <li>
            <a
              href={repo.url}
              target="_blank"
              rel="noopener noreferrer"
              data-sends={`planet:${i}`}
              data-orbit-focus={i}
            >
              <span class="repo-hud__dot" style={`background:${tints[i % tints.length]}`} aria-hidden="true" />
              {repo.name}
            </a>
          </li>
        ))
      }
    </ul>
  </aside>

  <script>
    import '../scripts/orbits.js';
  </script>
</Layout>
