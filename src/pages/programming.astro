---
import Layout from '../layouts/Layout.astro';
import { projects, skills } from '../data/site';

const built = projects.filter((project) => project.category !== 'Physics');
---

<Layout
  title="Programming"
  description="Software that has to survive contact with real users — computer vision, orchestration, interfaces and the tools behind the physics."
>
  <div class="shell">
    <section class="opener">
      <p class="opener__kicker">Programming</p>
      <h1 class="display display--md">
        Software is the only part of physics you can hand to someone else.
      </h1>
      <p class="lede">
        I write the tools I need: computer vision that runs without a datacentre, orchestration that
        cannot fail quietly, interfaces that show the data rather than a chart of it.
      </p>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">What I build with</h2>
        <p class="note">Chosen per problem, not per fashion.</p>
      </div>

      <div class="facts">
        {
          skills.map((group) => (
            <div class="facts__row">
              <span class="facts__key">{group.group}</span>
              <p class="facts__value">{group.items.join(' · ')}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Built and shipped</h2>
        <p class="note">
          Seven of ten here. The physics ones are on the <a class="link" href="/physics">physics page</a>.
        </p>
      </div>

      <div class="work">
        {
          built.map((project) => (
            <article class="work__item">
              <div class="work__row">
                <h3 class="work__name">{project.name}</h3>
                <span class="work__meta">
                  {project.year} · {project.status}
                </span>
              </div>
              <p class="work__line">{project.detail}</p>
              <p class="work__meta">{project.stack.join(' · ')}</p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
