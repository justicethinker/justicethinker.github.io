---
import Layout from '../layouts/Layout.astro';
import { education, skills, record, publications, stats } from '../data/site';
---

<Layout
  title="Record"
  description="Education, positions held, technical skills and publications."
>
  <div class="shell">
    <section class="opener">
      <p class="opener__kicker">Record</p>
      <h1 class="display display--md">The short version, stated plainly.</h1>
      <p class="lede">
        What I studied, where I worked, what I can be trusted to do, and what has been through review.
      </p>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Education</h2>
      </div>

      <div class="facts">
        <div class="facts__row">
          <span class="facts__key">{education.years}</span>
          <p class="facts__value">
            <strong>{education.degree}</strong>
            {education.honours}. Thesis: {education.thesis}.
          </p>
        </div>
        <div class="facts__row">
          <span class="facts__key">Coursework</span>
          <p class="facts__value">{education.coursework.join(' · ')}</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Positions</h2>
        <p class="note">Roles where the work was mine to finish.</p>
      </div>

      <div class="facts">
        {
          record.map((entry) => (
            <div class="facts__row">
              <span class="facts__key">{entry.when}</span>
              <div class="facts__value">
                <strong>{entry.role}</strong>
                <p>{entry.org}</p>
                <ul class="prose">
                  {entry.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Skills</h2>
      </div>

      <div class="facts">
        {
          skills.map((group) => (
            <div class="facts__row">
              <span class="facts__key">{group.group}</span>
              <p class="facts__value">{group.items.join(' · ')}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Publications</h2>
        <p class="note">Three papers through review.</p>
      </div>

      <div class="work">
        {
          publications.map((paper) => (
            <article class="work__item">
              <div class="work__row">
                <h3 class="work__name">{paper.title}</h3>
                <span class="work__meta">{paper.state}</span>
              </div>
              <p class="work__line">{paper.venue}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">In numbers</h2>
      </div>

      <div class="facts">
        {
          stats.map((stat) => (
            <div class="facts__row">
              <span class="facts__key">
                {stat.value} {stat.unit}
              </span>
              <p class="facts__value">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
