---
import Layout from '../layouts/Layout.astro';
import { speaking, talkingPoints, principles } from '../data/site';
---

<Layout
  title="Speaking"
  description="Competitive debate results, public talks, and the four rules every argument is held to."
>
  <div class="shell">
    <section class="opener">
      <p class="opener__kicker">Speaking</p>
      <h1 class="display display--md">An argument is an instrument. You find out what it is made of when someone pushes on it.</h1>
      <p class="lede">
        Four years of competitive finals, national titles, and coaching more than a hundred and fifty
        students to the same standard.
      </p>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Results</h2>
        <p class="note">Judged by people who were trying to win.</p>
      </div>

      <div class="work">
        {
          speaking.map((result) => (
            <article class="work__item">
              <div class="work__row">
                <h3 class="work__name">{result.event}</h3>
                <span class="work__meta">
                  {result.when} · {result.placing}
                </span>
              </div>
              <p class="work__line">
                {result.format} — {result.body}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Talks</h2>
        <p class="note">The same method, pointed at a room instead of an opponent.</p>
      </div>

      <div class="work">
        {
          talkingPoints.map((talk) => (
            <article class="work__item">
              <div class="work__row">
                <h3 class="work__name">{talk.title}</h3>
                <span class="work__meta">{talk.meta}</span>
              </div>
              <p class="work__line">
                {talk.venue} — {talk.hook}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Four rules</h2>
        <p class="note">Non-negotiable, and the reason coaching works.</p>
      </div>

      <div class="work work--plain">
        {
          principles.map((rule) => (
            <article class="work__item">
              <div class="work__row">
                <h3 class="work__name">{rule.name}</h3>
              </div>
              <p class="work__line">{rule.body}</p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
