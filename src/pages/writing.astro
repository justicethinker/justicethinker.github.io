---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import { essays, identity } from '../data/site';
---
<Layout
  title="Writing — Essays by Ikechukwu Emmanuel Isaac (Justice Thinker), Nigeria"
  description="Essays by Ikechukwu Emmanuel Isaac (Justice Thinker), a Full-Stack & AI Engineer in Nigeria, on judgment, argument and choosing who you become. Published on Substack."
>
  <header class="page-head">
    <div class="wrap">
      <p class="label label--ember">Writing</p>
      <h1>Essays on thinking clearly.</h1>
      <p>I write about judgment, argument and choosing who you become. Everything is on Substack, newest first.</p>
    </div>
  </header>

  <section class="section" aria-label="Essays">
    <div class="wrap">
      <ul class="essays">
        {essays.map((e) => (
          <li>
            <a href={e.url}>
              <time class="label" datetime={e.iso}>{e.date}</time>
              <div><h2 style="font-size:clamp(1.5rem,3vw,2.1rem)">{e.title}</h2><p>{e.body}</p></div>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="hero__actions" style="margin-top:2.5rem">
        <a class="btn btn--solid" href={identity.substack}>Subscribe on Substack <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <Contact />
</Layout>
