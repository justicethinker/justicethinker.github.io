---
import Layout from '../layouts/Layout.astro';
import { channels, identity } from '../data/site';
---

<Layout
  title="Contact"
  description={`Write to ${identity.legalName} about research, software, or anything worth arguing about.`}
>
  <div class="shell">
    <section class="opener">
      <p class="opener__kicker">Contact</p>
      <h1 class="display display--md">Say what you are trying to build, and where it is stuck.</h1>
      <p class="lede">
        Research collaborations, difficult engineering, or a claim you think I have wrong — all
        three are welcome.
      </p>
    </section>

    <section class="section">
      <div class="channels">
        {
          channels.map((channel) => (
            <div class="channel">
              <span class="channel__label">{channel.label}</span>
              <a class="channel__value link" href={channel.href} target={channel.href.startsWith('http') ? '_blank' : undefined} rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                {channel.value}
              </a>
              <p class="note">{channel.note}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Or write it here</h2>
        <p class="note">
          This form has no server behind it — it opens a draft in your own mail client, with your
          words already in it.
        </p>
      </div>

      <form class="form" data-contact-form data-contact-email={identity.email}>
        <div class="form__row form__row--two">
          <label class="field">
            <span class="field__label">Your name</span>
            <input class="field__input" type="text" name="name" autocomplete="name" required />
          </label>

          <label class="field">
            <span class="field__label">Your email</span>
            <input
              class="field__input"
              type="email"
              name="email"
              autocomplete="email"
              spellcheck="false"
              required
            />
          </label>
        </div>

        <label class="field">
          <span class="field__label">Subject</span>
          <input
            class="field__input"
            type="text"
            name="subject"
            autocomplete="off"
            placeholder="Research collaboration"
          />
        </label>

        <label class="field">
          <span class="field__label">Message</span>
          <textarea
            class="field__input"
            name="message"
            rows="7"
            required
            placeholder="State the problem plainly. Context helps."
          ></textarea>
        </label>

        <div class="form__foot">
          <button class="btn" type="submit">Open the draft</button>
          <p class="status" data-form-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </section>
  </div>
</Layout>
