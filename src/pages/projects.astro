---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/site';
---

<Layout
  title="Work"
  description="Ten projects across quantum simulation, computer vision, orchestration, instrumentation and scientific computing."
>
  <div class="shell">
    <section class="opener">
      <p class="opener__kicker">Work</p>
      <h1 class="display display--md">Ten things I built, and what each one was for.</h1>
      <p class="lede">
        Everything here started as a problem I could not solve with what already existed. Each entry
        says honestly what stage it reached.
      </p>
    </section>

    <section class="section section--tight">
      <div class="work">
        {
          projects.map((project) => (
            <article class="work__item">
              <div class="work__row">
                <h3 class="work__name">{project.name}</h3>
                <span class="work__meta">
                  {project.year} · {project.status}
                </span>
              </div>
              <p class="work__line">{project.summary}</p>
              <p class="work__meta">
                {project.category} — {project.stack.join(' · ')}
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
