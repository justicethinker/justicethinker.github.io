---
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';
import { projects, publications, researchAreas, education } from '../data/site';

const physicsProjects = projects.filter((project) => project.category === 'Physics');
---

<Layout
  title="Physics"
  description="Quantum mechanics, wave dynamics and instrumentation — research areas, papers and the projects behind them."
>
  <div class="shell">
    <section class="opener">
      <p class="opener__kicker">Physics</p>
      <h1 class="display display--md">
        The interesting part is where a system stops behaving the way the maths says it should.
      </h1>
      <p class="lede">
        I work on the quantum-to-classical boundary, on wave behaviour in real apparatus, and on the
        numerical methods that let either be checked against data.
      </p>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Research areas</h2>
        <p class="note">Each with its own apparatus. The method does not change between them.</p>
      </div>

      <div class="work work--plain">
        {
          researchAreas.map((area) => (
            <article class="work__item">
              <div class="work__row">
                <h3 class="work__name">{area.name}</h3>
              </div>
              <p class="work__line">{area.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <Figure
        src="/art/ink.webp"
        width={1600}
        height={1000}
        alt="Fine black contour lines on warm paper, forming a dense wave interference pattern that fades toward the edges of the sheet."
        caption="An interference field drawn as contours: three sources summed, the ink placed where the sum crosses a fixed value."
      />
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Papers</h2>
        <p class="note">Peer reviewed and in review.</p>
      </div>

      <div class="work">
        {
          publications.map((paper) => (
            <article class="work__item">
              <div class="work__row">
                <h3 class="work__name">{paper.title}</h3>
                <span class="work__meta">{paper.state}</span>
              </div>
              <p class="work__line">
                {paper.venue} — {paper.abstract}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Built for the work</h2>
        <p class="note">When nothing affordable resolves the effect, you build the thing that does.</p>
      </div>

      <div class="work">
        {
          physicsProjects.map((project) => (
            <article class="work__item">
              <div class="work__row">
                <h3 class="work__name">{project.name}</h3>
                <span class="work__meta">
                  {project.year} · {project.status}
                </span>
              </div>
              <p class="work__line">{project.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2 class="title">Education</h2>
      </div>

      <div class="facts">
        <div class="facts__row">
          <span class="facts__key">Degree</span>
          <p class="facts__value">
            <strong>{education.degree}</strong>
            {education.honours} · {education.years}
          </p>
        </div>
        <div class="facts__row">
          <span class="facts__key">Thesis</span>
          <p class="facts__value">{education.thesis}</p>
        </div>
        <div class="facts__row">
          <span class="facts__key">Coursework</span>
          <p class="facts__value">{education.coursework.join(' · ')}</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
