---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/site';
---

<Layout
  title="Writing"
  description="Essays on physics, software and the ethics of the systems we build."
>
  <div class="shell">
    <section class="opener">
      <p class="opener__kicker">Writing</p>
      <h1 class="display display--md">I write to find out what I actually think.</h1>
      <p class="lede">
        Longer pieces on physics, software, and the parts of both that are argued about rather than
        proved.
      </p>
    </section>

    <section class="section section--tight">
      <div class="posts">
        {
          posts.map((post) => (
            <article class="post">
              <time class="post__date" datetime={post.iso}>
                {post.date} · {post.reading}
              </time>
              <h2 class="post__title">{post.title}</h2>
              <p class="post__dek">{post.dek}</p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
