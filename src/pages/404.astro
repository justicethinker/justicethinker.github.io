---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found" description="That page does not exist.">
  <div class="shell">
    <section class="opener">
      <p class="kicker">404</p>
      <h1 class="display display--md">This page is <span class="gold">not here.</span></h1>
      <p class="lede">
        The link may be old, or the address mistyped. Everything that does exist is one
        page away.
      </p>
      <div class="actions">
        <a class="btn btn--gold" href="/">Back to me</a>
        <a class="btn btn--ghost" href="/tech">Tech</a>
        <a class="btn btn--ghost" href="/writing">Writing</a>
      </div>
    </section>
  </div>
</Layout>
