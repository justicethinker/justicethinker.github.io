---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found" description="That page does not exist.">
  <div class="shell">
    <section class="opener">
      <p class="opener__kicker">404</p>
      <h1 class="display display--md">This page is not here.</h1>
      <p class="lede">
        The link may be old, or the address mistyped. Everything that does exist is one page away.
      </p>
    </section>

    <section class="section section--tight">
      <div class="work">
        <article class="work__item">
          <p class="work__line">
            <a class="link link--accent" href="/">Back to the home page</a> — or see the
            <a class="link" href="/projects">work</a> and the
            <a class="link" href="/blog">writing</a>.
          </p>
        </article>
      </div>
    </section>
  </div>
</Layout>
