---
import { identity, navPrimary } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot__inner">
    <p>© {year} {identity.name} · Justice Thinker · {identity.city}, {identity.country}</p>
    <nav aria-label="Footer">
      <a href="/">Home</a>
      {navPrimary.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href={identity.github} rel="me">GitHub</a>
      <a href={identity.linkedin} rel="me">LinkedIn</a>
    </nav>
  </div>
</footer>
