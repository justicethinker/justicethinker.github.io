---
import { identity, navPrimary, navAll } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href.replace(/\/+$/, '') || '/') === path;
---

<header class="masthead">
  <div class="shell masthead__inner">
    <a class="brand" href="/" aria-label={`${identity.name} — home`}>
      <span class="brand__coin" aria-hidden="true">J</span>
      {identity.name}
    </a>

    <nav class="nav" aria-label="Primary">
      {
        navPrimary.map((item) => (
          <a class="nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      class="nav__toggle"
      type="button"
      data-drawer-toggle
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span aria-hidden="true">☰</span>
      <span>Menu</span>
    </button>
  </div>
</header>

<div class="scrim" data-scrim hidden></div>

<div
  class="drawer"
  id="site-menu"
  data-drawer
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  hidden
>
  <div class="drawer__head">
    <span class="micro">Menu</span>
    <button class="drawer__close" type="button" data-drawer-close>Close</button>
  </div>

  <nav class="drawer__list" aria-label="All pages">
    {
      navAll.map((item) => (
        <a class="drawer__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="drawer__foot">
    <a class="link" href={`mailto:${identity.email}`}>{identity.email}</a>
    <a class="link" href={identity.github} target="_blank" rel="noopener noreferrer">{identity.githubHandle}</a>
    <a class="link" href={identity.substack} target="_blank" rel="noopener noreferrer">{identity.substackHandle}</a>
  </div>
</div>
